@page "/account/forgot-password"
@model ShutkiVorta.Web.Pages.Account.ForgotPasswordModel
<section class="section">
    <div class="container auth-wrap">
        <div class="auth-head">
            <h1 style="font-size:2.2rem;">Forgot your password?</h1>
            <p class="muted">Enter your email and we'll send you a link to choose a new one.</p>
        </div>
        <form method="post" class="form-card kantha">
            @if (Model.Sent)
            {
                <div class="alert alert-success">If an account exists for <strong>@Model.Email</strong>, a reset link is on its way. Please check your inbox.</div>
            }
            <div class="field mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <button class="btn btn-primary btn-block btn-lg" type="submit">Email me a reset link</button>
        </form>
        <p class="auth-alt"><a href="/account/login">&larr; Back to sign in</a></p>
    </div>
</section>
