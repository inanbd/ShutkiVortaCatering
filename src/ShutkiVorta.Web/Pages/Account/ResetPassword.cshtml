@page "/account/reset-password"
@model ShutkiVorta.Web.Pages.Account.ResetPasswordModel
<section class="section">
    <div class="container auth-wrap">
        <div class="auth-head">
            <h1 style="font-size:2.2rem;">@Model.Heading</h1>
            @if (Model.IsInvitation && !Model.InvitationExpired)
            {
                <p class="muted">Welcome to the team! Choose the password you'll use to sign in and clock in and out.</p>
            }
        </div>
        @if (Model.InvitationExpired)
        {
            <div class="form-card kantha">
                <div class="alert alert-error" role="alert">@ShutkiVorta.Application.Features.Staff.StaffInvitations.ExpiredOrUsed</div>
                <p class="mb-0">Already set your password? <a href="/account/login">Sign in</a> with your email and that password.</p>
            </div>
        }
        else
        {
            <form method="post" class="form-card kantha">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <input type="hidden" asp-for="Input.Code" />
                @if (Model.IsInvitation)
                {
                    <input type="hidden" name="invite" value="1" />
                }
                <div class="field mb-2">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" type="email" autocomplete="username" readonly="@Model.IsInvitation" />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>
                <div class="field mb-2">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                    @if (Model.IsInvitation)
                    {
                        <span class="hint">At least 8 characters, with a number and a lowercase letter.</span>
                    }
                </div>
                <div class="field mb-3">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>
                <button class="btn btn-primary btn-block btn-lg" type="submit">@(Model.IsInvitation ? "Set password and sign in" : "Save new password")</button>
            </form>
        }
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
