@page "/account/manage/change-password"
@model ShutkiVorta.Web.Pages.Account.Manage.ChangePasswordModel

<section class="section-sm">
    <div class="container">
        <h1 style="font-size:2.4rem;">My account</h1>
        <div class="account-layout">
            <partial name="_AccountNav" />
            <div>
                <partial name="_StatusMessage" />
                <form method="post" class="form-card kantha" style="max-width:560px;">
                    <h2 style="font-size:1.8rem;">Change password</h2>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="field mb-2">
                        <label asp-for="Input.CurrentPassword"></label>
                        <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
                        <span asp-validation-for="Input.CurrentPassword" class="field-validation-error"></span>
                    </div>
                    <div class="field mb-2">
                        <label asp-for="Input.NewPassword"></label>
                        <input asp-for="Input.NewPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
                    </div>
                    <div class="field mb-3">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                    </div>
                    <button class="btn btn-primary" type="submit">Update password</button>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
