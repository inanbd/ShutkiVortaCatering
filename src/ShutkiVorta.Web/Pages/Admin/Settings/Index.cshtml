@page
@model ShutkiVorta.Web.Pages.Admin.Settings.IndexModel
@{
    var s = Model.Settings;
}
<p class="settings-lead">Change how the website and the kitchen work. <strong>Changes apply immediately</strong> and are kept in the database, so they survive updates and restarts.</p>

@if (Model.Notices.PagesNeedingReview.Count > 0)
{
    <div class="alert alert-warn settings-notice" role="alert" data-settings-review>
        <strong>Please check these settings:</strong>
        @for (var i = 0; i < Model.Notices.PagesNeedingReview.Count; i++)
        {
            var p = Model.Notices.PagesNeedingReview[i];
            <text>@(i == 0 ? "" : ", ")<a href="/admin/settings/@p.Slug">@p.Title</a></text>
        }.
        They were not found in the server configuration when this version was installed, so the built-in defaults were stored.
        Open each page, correct anything that is wrong and save it.
    </div>
}
@if (Model.Notices.RejectedKeys.Count > 0)
{
    <div class="alert alert-error settings-notice" role="alert" data-settings-rejected>
        <strong>Some saved settings could not be used</strong> and their defaults are in effect: <code class="inline">@string.Join(", ", Model.Notices.RejectedKeys)</code>.
        Open the page they belong to and save it again.
    </div>
}
@if (Model.Notices.IgnoredConfigurationKeys.Count > 0)
{
    <div class="alert alert-info settings-notice" role="status" data-settings-ignored>
        <strong>Ignored server configuration:</strong> appsettings.json or environment variables on the server set
        <code class="inline">@string.Join(", ", Model.Notices.IgnoredConfigurationKeys)</code>, but the values saved here are used instead.
        Ask whoever hosts the site to remove them, so nobody is misled.
    </div>
}

<div class="settings-cards">
    @foreach (var card in Model.Cards)
    {
        var sp = card.Page;
        var href = $"/admin/settings/{sp.Slug}";
        <article class="settings-card">
            <span class="settings-card-icon">@Icons.Get(sp.Icon)</span>
            <div class="settings-card-body">
                <h2><a href="@href">@sp.Title</a></h2>
                @if (card.Summary.NeedsReview)
                {
                    <span class="pill pill-warn">Please check</span>
                }
                <p>@sp.Description</p>
                @if (card.Facts.Count > 0)
                {
                    <ul class="settings-card-facts">
                        @foreach (var fact in card.Facts)
                        {
                            <li>
                                @if (fact.Pill is not null)
                                {
                                    <span class="pill @fact.Pill">@fact.Text</span>
                                }
                                else
                                {
                                    @fact.Text
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="settings-card-foot">
                <span class="small muted">@SettingsForm.LastChanged(card.Summary.LastChangedAtLocal, card.Summary.LastChangedBy)</span>
                <a class="btn btn-outline btn-sm" href="@href" aria-label="Edit @sp.Title">@Icons.Get("edit") Edit</a>
            </div>
        </article>
    }
</div>

<partial name="_EmailDiagnostics" model="Model.EmailDiagnostics" />

<section class="panel">
    <div class="panel-head"><h2>Server</h2><span class="pill pill-off">appsettings.json</span></div>
    <div class="panel-body">
        <p class="muted mt-0">A few things are part of the server setup and are changed by whoever hosts the site, not here: the database connection, data-protection keys (which also protect the saved SMTP password), logging, the email pickup folder and the first admin account.</p>
        <table class="table settings-table">
            <tr><td>Database</td><td>@s.DatabaseProvider<br /><span class="small muted">@s.DatabaseSource</span></td></tr>
            <tr><td>Sitemap / robots</td><td><a href="/sitemap.xml" target="_blank" rel="noopener">sitemap.xml</a> &middot; <a href="/robots.txt" target="_blank" rel="noopener">robots.txt</a> <span class="small muted">(updated automatically when the menu or website settings change)</span></td></tr>
        </table>
    </div>
</section>
