@using ShutkiVorta.Application.Common.Interfaces
@inject ICurrentUser CurrentUser
@{
    var path = Context.Request.Path.Value ?? "/admin";
    string? Active(string prefix, bool exact = false) =>
        (exact ? path.Equals(prefix, StringComparison.OrdinalIgnoreCase) : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Admin · Shutki Vorta</title>
    <link rel="icon" href="~/images/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Hind+Siliguri:wght@400;500;600;700&family=Tiro+Bangla&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="brand" href="/admin">
                <img src="~/images/logo-mark.svg" alt="" width="42" height="42" />
                <span class="brand-text">
                    <span class="brand-name">Shutki Vorta</span>
                    <span class="brand-sub">Admin · পরিচালনা</span>
                </span>
            </a>
            <ul class="admin-nav">
                <li><a class="@Active("/admin", exact: true)" href="/admin">@Icons.Get("dashboard") Dashboard</a></li>
                <li><a class="@Active("/admin/orders")" href="/admin/orders">@Icons.Get("receipt") Orders</a></li>
                <li><a class="@Active("/admin/menu")" href="/admin/menu">@Icons.Get("bowl") Menu items</a></li>
                <li><a class="@Active("/admin/inquiries")" href="/admin/inquiries">@Icons.Get("chat") Inquiries</a></li>
                <li><a class="@Active("/admin/customers")" href="/admin/customers">@Icons.Get("users") Customers</a></li>
                <li><a class="@Active("/admin/emails")" href="/admin/emails">@Icons.Get("mail") Email log</a></li>
                <li><a class="@Active("/admin/settings")" href="/admin/settings">@Icons.Get("settings") Settings</a></li>
                <li><a href="/" target="_blank" rel="noopener">@Icons.Get("external") View website</a></li>
            </ul>
            <div class="spacer"></div>
            <form method="post" action="/account/logout">
                @Html.AntiForgeryToken()
                <button type="submit">@Icons.Get("logout") Sign out</button>
            </form>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="flex items-center gap-2 no-print">
                    @RenderSection("Actions", required: false)
                    <span class="who">@CurrentUser.Name</span>
                </div>
            </header>
            <div class="admin-band" aria-hidden="true"></div>
            <main class="admin-content">
                <partial name="_StatusMessage" />
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
