@page "/contact"
@model ContactModel
@{
    var b = Model.Business;
    var phoneHref = "tel:" + new string(b.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
    ViewData["ShowEventFields"] = false;
}

<section class="page-banner">
    <div class="container">
        <span class="bn-title" lang="bn">যোগাযোগ</span>
        <h1>Contact Us</h1>
        <p>We'd love to hear from you &mdash; questions, special requests or just a craving for home.</p>
    </div>
    <div class="bunting" aria-hidden="true"></div>
</section>

<section class="section">
    <div class="container cart-layout" style="grid-template-columns:1fr 1.3fr;">
        <div>
            <div class="side-card">
                <h3>Call or text</h3>
                <p><a href="@phoneHref">@Icons.Get("phone") @b.Phone</a></p>
                <h3 class="mt-3">Email</h3>
                <p><a href="mailto:@b.Email">@Icons.Get("mail") @b.Email</a></p>
                <h3 class="mt-3">Kitchen &amp; pickup</h3>
                <p>@Icons.Get("pin") @b.FullAddress<br /><span class="small muted">@b.PickupInstructions</span></p>
                <h3 class="mt-3">Hours</h3>
                <p class="mb-0">@Icons.Get("clock") @b.OpeningHoursText</p>
            </div>
            <div class="side-card">
                <h3>Planning an event?</h3>
                <p class="small">Weddings, dawat, Eid or corporate lunches &mdash; use our catering form for a tailored quote.</p>
                <a class="btn btn-green btn-sm" href="/catering">Catering inquiry</a>
            </div>
        </div>
        <div>
            @if (Model.Submitted)
            {
                <div class="form-card kantha text-center">
                    <p class="bn" lang="bn" style="font-size:2rem;color:var(--red-700);">ধন্যবাদ!</p>
                    <h3>Message sent</h3>
                    <p class="muted mb-0">We'll get back to you within one business day.</p>
                </div>
            }
            else
            {
                <form method="post" class="form-card kantha">
                    <h2 style="font-size:1.8rem;">Send us a message</h2>
                    <partial name="_InquiryForm" for="Input" />
                    <button class="btn btn-primary btn-lg mt-3" type="submit">Send message</button>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
