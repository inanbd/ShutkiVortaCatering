@page
@model ShutkiVorta.Web.Pages.Menu.IndexModel

<section class="page-banner">
    <div class="container">
        <span class="bn-title" lang="bn">আমাদের মেনু</span>
        <h1>Our Menu</h1>
        <p>Every vorta is roasted, pounded and finished with mustard oil on the day of your order. Priced per pound &mdash; order from half a pound.</p>
    </div>
    <div class="bunting" aria-hidden="true"></div>
</section>

<section class="section">
    <div class="container">
        <partial name="_StatusMessage" />
        <nav class="category-nav" aria-label="Menu categories">
            @foreach (var group in Model.Sections)
            {
                <a href="#@group.Key.ToString().ToLowerInvariant()">@group.First().CategoryName</a>
            }
        </nav>
        <div class="menu-note">
            <span>Sold by the pound, from ½ lb</span>
            <span>Order @Model.Ordering.MinimumLeadTimeHours+ hours ahead</span>
            <span>Pickup or delivery in @Model.Ordering.DeliveryAreaDescription</span>
        </div>

        @foreach (var group in Model.Sections)
        {
            var first = group.First();
            <section class="menu-section" id="@group.Key.ToString().ToLowerInvariant()" aria-labelledby="h-@group.Key">
                <header class="section-head">
                    <span class="bn-title" lang="bn">@first.CategoryBengaliName</span>
                    <h2 id="h-@group.Key">@(first.CategoryName)s</h2>
                    @if (group.Key == MenuCategory.ShutkiVorta)
                    {
                        <p>Bold, smoky and deeply savory &mdash; our signature dried-fish vortas, made the Chattogram and Mymensingh way.</p>
                    }
                    else
                    {
                        <p>Comforting everyday vortas from roasted vegetables, lentils and seeds. Most are naturally vegan and gluten-free.</p>
                    }
                </header>
                <div class="menu-grid cols-3">
                    @foreach (var item in group)
                    {
                        <partial name="_MenuCard" model="item" />
                    }
                </div>
            </section>
        }

        @if (Model.Sections.Count == 0)
        {
            <div class="empty-state">
                <p class="bn">শীঘ্রই আসছে</p>
                <p>Our menu is being updated. Please check back soon!</p>
            </div>
        }
    </div>
</section>
