@page "/error/{code:int?}"
@model ErrorModel
@{
    var (bn, title, text) = Model.Code switch
    {
        404 => ("খুঁজে পাওয়া যায়নি", "We couldn't find that page", "The page may have moved, or the vorta you're looking for is no longer on the menu."),
        401 or 403 => ("প্রবেশ নিষেধ", "You don't have access to this page", "Please sign in with an account that has permission to view it."),
        _ => ("দুঃখিত!", "Something went wrong", "Our kitchen had a hiccup. Please try again in a moment."),
    };
}
<section class="error-page">
    <div class="container container-narrow">
        <div class="code">@Model.Code</div>
        <p class="bn" lang="bn" style="font-size:1.8rem;color:var(--red-700);">@bn</p>
        <h1>@title</h1>
        <p class="muted">@text</p>
        <partial name="_AlponaDivider" />
        <div class="flex gap-2 wrap mt-3" style="justify-content:center;">
            <a class="btn btn-primary" href="/menu">See the menu</a>
            <a class="btn btn-outline" href="/">Go home</a>
        </div>
        @if (Model.Code >= 500)
        {
            <p class="small muted mt-3">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
